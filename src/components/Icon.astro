---
interface Props {
  name: string;
}
const { name } = Astro.props;
---

<svg class="glyph" viewBox="0 0 48 48" aria-hidden="true">
  {
    name === "print" && (
      <g fill="none" stroke="currentColor" stroke-width="2.4" stroke-linejoin="round">
        <path d="M14 18V10h20v8" />
        <rect x="10" y="18" width="28" height="14" rx="3" />
        <path d="M16 32h16v8H16z" />
      </g>
    )
  }
  {
    name === "card" && (
      <g fill="none" stroke="currentColor" stroke-width="2.4">
        <rect x="8" y="12" width="32" height="24" rx="3" />
        <circle cx="18" cy="24" r="4" />
        <path d="M26 21h10M26 27h8" />
      </g>
    )
  }
  {
    name === "scan" && (
      <g fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round">
        <path d="M12 16V12h6M30 12h6v4M36 32v4h-6M18 36h-6v-4" />
        <path d="M12 24h24" />
      </g>
    )
  }
  {
    name === "form" && (
      <g fill="none" stroke="currentColor" stroke-width="2.4" stroke-linejoin="round">
        <path d="M16 8h12l8 8v24H16z" />
        <path d="M28 8v8h8M20 24h12M20 30h12" />
      </g>
    )
  }
  {
    name === "id" && (
      <g fill="none" stroke="currentColor" stroke-width="2.4">
        <rect x="10" y="8" width="28" height="32" rx="3" />
        <circle cx="24" cy="20" r="5" />
        <path d="M16 34c1.5-4 4-6 8-6s6.5 2 8 6" />
      </g>
    )
  }
  {
    name === "shield" && (
      <g fill="none" stroke="currentColor" stroke-width="2.4" stroke-linejoin="round">
        <path d="M24 8l14 6v10c0 8-6 12-14 16C16 36 10 32 10 24V14z" />
        <path d="M18 24l4 4 8-9" />
      </g>
    )
  }
  {
    name === "plane" && (
      <path
        fill="currentColor"
        d="M40 22 10 12l2 8-8 2 2 4 8-1 4 10 4-2-2-9 12-2z"
      />
    )
  }
</svg>
