---
import { site, quickLinks } from "../data/site";
---

<footer class="site-footer">
  <div class="wrap footer-grid">
    <div>
      <h2>Contact</h2>
      <p><a href={site.phoneTel}>{site.phoneDisplay}</a></p>
      <p>{site.hours}</p>
      <p class="tagline" lang="gu">{site.tagline}</p>
    </div>
    <div>
      <h2>Location</h2>
      <div class="map-card">
        <div>
          <div class="map-pin" aria-hidden="true"></div>
          <strong>{site.location}</strong>
        </div>
      </div>
    </div>
    <div>
      <h2>Quick links</h2>
      <ul>
        {quickLinks.map((link) => (
          <li><a href={link.href}>{link.label}</a></li>
        ))}
      </ul>
    </div>
  </div>
  <div class="wrap">
    <p class="footer-note">{site.name}</p>
  </div>
</footer>
