---
import Outbound from "./Outbound.astro";
import updates from "../data/updates.json";

const items = updates.ticker.length
  ? updates.ticker
  : [{ text: "Notices appear here after the update script runs.", source: "", url: "", sample: true }];
const loop = [...items, ...items];

function safeUrl(url) {
  if (!url || /sarkariresult\.com|majhinaukri\.in/i.test(url)) return "";
  return url;
}
---

<div class="live-bar" aria-label="Live updates">
  <div class="live-label">Live updates</div>
  <div class="ticker-window">
    <div class="ticker-track">
      {
        loop.map((item) => (
          <span>
            {safeUrl(item.url) ? <Outbound href={safeUrl(item.url)}>{item.text}</Outbound> : item.text}
            {item.sample ? " (sample)" : ""}
          </span>
        ))
      }
    </div>
  </div>
</div>
