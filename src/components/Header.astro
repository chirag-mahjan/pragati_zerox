---
import { nav } from "../data/site";
import Icon from "./Icon.astro";

const path = Astro.url.pathname.replace(/\/$/, "") || "/";
---

<a class="skip" href="#content">Skip to content</a>
<header class="site-header">
  <div class="wrap header-bar">
    <a class="lockup" href="/">
      <span class="lockup-mark" aria-hidden="true"><Icon name="print" /></span>
      <span>
        <span class="lockup-name">PRAGATI</span>
        <span class="lockup-sub">XEROX & GOVT. SCHEMES CENTER</span>
      </span>
    </a>
    <input class="nav-toggle" id="nav-toggle" type="checkbox" />
    <label class="nav-burger" for="nav-toggle">Menu</label>
    <ul class="nav-links">
      {
        nav.map((item) => {
          const current = item.href === "/" && path === "/" ? "page" : item.href === path ? "page" : undefined;
          return (
            <li>
              <a href={item.href} aria-current={current}>
                {item.label}
              </a>
            </li>
          );
        })
      }
    </ul>
  </div>
</header>
