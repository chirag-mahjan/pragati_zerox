---
import { nav, site } from "../data/site";
import Icon from "./Icon.astro";

const path = Astro.url.pathname.replace(/\/$/, "") || "/";
---

<a class="skip" href="#content">Skip to content</a>
<header class="site-header">
  <div class="wrap header-bar">
    <a class="lockup" href="/">
      <span class="lockup-mark" aria-hidden="true"><Icon name="print" /></span>
      <span>
        <span class="lockup-name">PRAGATI</span>
        <span class="lockup-sub">{site.lockupBottom}</span>
      </span>
    </a>
    <input class="nav-toggle" id="nav-toggle" type="checkbox" />
    <label class="nav-burger" for="nav-toggle">Menu</label>
    <ul class="nav-links">
      {
        nav.map((item) => {
          const current = item.href === "/" && path === "/" ? "page" : item.href === path ? "page" : undefined;
          return (
            <li>
              <a href={item.href} aria-current={current}>
                {item.label}
              </a>
            </li>
          );
        })
      }
      <li class="lang-switch">
        <a data-translate="hi" href="https://translate.google.com/translate?sl=auto&tl=hi" target="_blank" rel="noopener noreferrer">हिंदी</a>
        <a data-translate="gu" href="https://translate.google.com/translate?sl=auto&tl=gu" target="_blank" rel="noopener noreferrer">ગુજરાતી</a>
      </li>
    </ul>
  </div>
</header>
<script is:inline>
  const page = encodeURIComponent(location.href);
  for (const link of document.querySelectorAll("[data-translate]")) {
    const lang = link.getAttribute("data-translate");
    link.href = "https://translate.google.com/translate?sl=auto&tl=" + lang + "&u=" + page;
  }
</script>
