---
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import { serviceGroups } from "../data/site";
---

<Base title="Xerox & Digital Services" description="Printing, typing, tickets, SIM, and bill payment at Pragati Digital & Xerox Center.">
  <header class="page-intro">
    <div class="wrap">
      <h1>Xerox & Digital Services</h1>
      <p>Copies, CSC applications, loans, RTO work, GST, and income-tax returns. Come to the shop or call, and we do the work with you.</p>
    </div>
  </header>
  <div class="page">
    <div class="wrap groups">
      {
        serviceGroups.map((group) => (
          <section class="group" id={group.id}>
            <div class="group-head">
              <div class:list={["tile-icon", group.tone]}><Icon name={group.icon} /></div>
              <h2>{group.title}</h2>
            </div>
            <ul>
              {group.items.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </section>
        ))
      }
    </div>
  </div>
</Base>
