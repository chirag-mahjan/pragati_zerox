---
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import Ticker from "../components/Ticker.astro";
import { site, printTiles, schemeTiles, digitalTiles } from "../data/site";
---

<Base title={site.name}>
  <section class="hero">
    <div class="wrap hero-grid">
      <div>
        <h1>Pragati Xerox &<br />Online Center</h1>
        <p class="lede">{site.heroSub}</p>
        <a class="button" href="/services">Explore Services</a>
      </div>
      <div class="hero-visual">
        <img src="/pragati-hero.jpg" alt="Staff member printing a xerox copy at an open photocopier" width="1200" height="900" />
      </div>
    </div>
  </section>

  <section class="band">
    <div class="wrap">
      <h2>Digital Xerox & Printing</h2>
      <div class="tiles">
        {
          printTiles.map((tile) => (
            <article class="tile">
              <div class:list={["tile-icon", tile.tone]}><Icon name={tile.icon} /></div>
              <h3>{tile.title}</h3>
              <p>{tile.text}</p>
              <a class:list={["more", tile.tone]} href={tile.href}>Read more</a>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="seal-band">
    <div class="wrap">
      <h2>Popular Services</h2>
      <div class="seals">
        <div class="medal gold"><span>Loan<br />services</span></div>
        <div class="medal teal"><span>CSC<br />services</span></div>
        <div class="medal navy"><span>Gov<br />services</span></div>
      </div>
      <Ticker />
    </div>
  </section>

  <section class="band">
    <div class="wrap">
      <h2>Government Schemes Hub</h2>
      <div class="tiles three">
        {
          schemeTiles.map((tile) => (
            <article class="tile">
              <div class:list={["tile-icon", tile.tone]}><Icon name={tile.icon} /></div>
              <h3>{tile.title}</h3>
              <p>{tile.text}</p>
              <a class:list={["more", tile.tone]} href={tile.href}>Read more</a>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="band">
    <div class="wrap">
      <h2>Digital Services</h2>
      <div class="tiles three">
        {
          digitalTiles.map((tile) => (
            <article class="tile">
              <div class:list={["tile-icon", tile.tone]}><Icon name={tile.icon} /></div>
              <h3>{tile.title}</h3>
              <p>{tile.text}</p>
              <a class:list={["more", tile.tone]} href={tile.href}>Read more</a>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="band about" id="about">
    <div class="wrap">
      <div class="about-card">
        <div>
          <h2>About</h2>
          <p>
            Pragati Digital & Xerox Center is run by {site.owners.join(" and ")}. The shop handles printing, typing, scheme forms, and exam applications.
          </p>
          <p>{site.location}</p>
          <p class="tagline" lang="gu">{site.tagline}</p>
        </div>
        <div>
          <p>
            <a href={site.phoneTel}>{site.phoneDisplay}</a>
            <span class="primary-tag">Primary</span>
          </p>
          <p><a href={site.phoneAltTel}>{site.phoneAltDisplay}</a></p>
          <p>{site.hoursLong}</p>
        </div>
      </div>
    </div>
  </section>
</Base>
