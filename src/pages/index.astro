---
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import Ticker from "../components/Ticker.astro";
import { site, printTiles, schemeTiles, digitalTiles } from "../data/site";
---

<Base title={site.name}>
  <section class="hero">
    <div class="wrap hero-grid">
      <div>
        <h1>Pragati Xerox &<br />Govt. Schemes Center</h1>
        <p class="lede">{site.heroSub}</p>
        <a class="button" href="/services">Explore Services</a>
      </div>
      <div class="hero-visual">
        <svg viewBox="0 0 520 420" role="img" aria-label="Shop photo">
          <rect width="520" height="420" fill="#f3f6f4" />
          <ellipse cx="330" cy="360" rx="150" ry="18" fill="#d9e3ea" />
          <rect x="250" y="168" width="190" height="120" rx="10" fill="#f7f9fb" stroke="#c5d0da" stroke-width="3" />
          <rect x="268" y="186" width="120" height="70" rx="4" fill="#e7eef3" />
          <path d="M268 168 L310 128 H430 L388 168 Z" fill="#ffffff" stroke="#c5d0da" stroke-width="3" />
          <rect x="300" y="288" width="90" height="16" rx="2" fill="#d5dee6" />
          <rect x="318" y="304" width="54" height="36" fill="#fff" stroke="#d5dee6" />
          <circle cx="188" cy="168" r="36" fill="#f0c7a4" />
          <path d="M158 162c6-28 54-28 60 2-16-10-44-8-60-2z" fill="#1d2430" />
          <path d="M176 180c8 8 22 8 30 0" fill="none" stroke="#c4896a" stroke-width="2" />
          <circle cx="176" cy="164" r="2.5" fill="#243140" />
          <circle cx="202" cy="164" r="2.5" fill="#243140" />
          <path d="M150 210h78l18 78H214l-10-46-28 46h-28l20-46-18 8z" fill="#0b2748" />
          <path d="M168 214h42l6 16H176z" fill="#14a3a1" />
          <rect x="214" y="248" width="46" height="14" rx="6" fill="#f0c7a4" />
          <rect x="156" y="286" width="22" height="54" rx="8" fill="#10243f" />
          <rect x="196" y="286" width="22" height="54" rx="8" fill="#10243f" />
        </svg>
      </div>
    </div>
  </section>

  <section class="band">
    <div class="wrap">
      <h2>Digital Xerox & Printing</h2>
      <div class="tiles">
        {
          printTiles.map((tile) => (
            <article class="tile">
              <div class:list={["tile-icon", tile.tone]}><Icon name={tile.icon} /></div>
              <h3>{tile.title}</h3>
              <p>{tile.text}</p>
              <a class:list={["more", tile.tone]} href={tile.href}>Read more</a>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="seal-band">
    <div class="wrap">
      <h2>Popular Services</h2>
      <div class="seals">
        <div class="medal gold"><span>Popular<br />services</span></div>
        <div class="medal teal"><span>Government<br />services</span></div>
        <div class="medal navy"><span>More<br />services</span></div>
      </div>
      <Ticker />
    </div>
  </section>

  <section class="band">
    <div class="wrap">
      <h2>Government Schemes Hub</h2>
      <div class="tiles three">
        {
          schemeTiles.map((tile) => (
            <article class="tile">
              <div class:list={["tile-icon", tile.tone]}><Icon name={tile.icon} /></div>
              <h3>{tile.title}</h3>
              <p>{tile.text}</p>
              <a class:list={["more", tile.tone]} href={tile.href}>Read more</a>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="band">
    <div class="wrap">
      <h2>Digital Services</h2>
      <div class="tiles three">
        {
          digitalTiles.map((tile) => (
            <article class="tile">
              <div class:list={["tile-icon", tile.tone]}><Icon name={tile.icon} /></div>
              <h3>{tile.title}</h3>
              <p>{tile.text}</p>
              <a class:list={["more", tile.tone]} href={tile.href}>Read more</a>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="band about" id="about">
    <div class="wrap">
      <div class="about-card">
        <div>
          <h2>About</h2>
          <p>
            Pragati Digital & Xerox Center is a CSC centre run by {site.owners.join(" and ")}. CSC ID {site.cscId}. The shop handles printing, typing, scheme forms, and exam applications.
          </p>
          <p>{site.location}</p>
          <p class="tagline" lang="gu">{site.tagline}</p>
        </div>
        <div>
          <p>
            <a href={site.phoneTel}>{site.phoneDisplay}</a>
            <span class="primary-tag">Primary</span>
          </p>
          <p><a href={site.phoneAltTel}>{site.phoneAltDisplay}</a></p>
          <p>{site.hoursLong}</p>
        </div>
      </div>
    </div>
  </section>
</Base>
