---
import Base from "../layouts/Base.astro";
import { site } from "../data/site";
import updates from "../data/updates.json";
---

<Base title="Government Schemes Hub" description="Scheme help at Pragati Digital & Xerox Center in Andada.">
  <header class="page-intro">
    <div class="wrap">
      <h1>Government Schemes Hub</h1>
      <p>We prepare and submit these applications at the Andada center. Exam boards for Gujarat, Maharashtra, Uttar Pradesh, Bihar, and Madhya Pradesh are checked with the daily update. This page does not apply online.</p>
    </div>
  </header>
  <div class="page">
    <div class="wrap">
      <div class="groups">
        {
          updates.schemes.groups.map((group) => (
            <section class="group" id={group.id}>
              <h2>{group.title}</h2>
              <ul>
                {group.items.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </section>
          ))
        }
      </div>
      {
        updates.schemes.notices.length > 0 && (
          <section class="band">
            <h2>Recent public notices</h2>
            <ul class="notice-list">
              {updates.schemes.notices.map((notice) => (
                <li>
                  <a href={notice.url}>{notice.title}</a>
                  <span class="source-link">{notice.source}</span>
                </li>
              ))}
            </ul>
          </section>
        )
      }
      <aside class="cta">
        <p>{site.schemeCta}</p>
        <div class="actions">
          <a class="button" href={site.phoneTel}>{site.callLabel}</a>
          <span>{site.location}</span>
        </div>
      </aside>
    </div>
  </div>
</Base>
